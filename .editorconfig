# EditorConfig para o projeto HCM Identity Provisioning Automation
# Padrões para .NET 10 / C# 14

root = true

# Todas as extensões de arquivo
[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown e JSON
[*.{md,json}]
indent_size = 2

# Arquivos de código C#
[*.cs]
# Organização de namespaces (File-scoped namespaces do C# 10+)
csharp_style_namespace_declarations = file_scoped:suggestion

# Usings fora de namespaces
csharp_using_directive_placement = outside_namespace:suggestion

# Modificadores de acessibilidade
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# Preferência de var
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expressões em corpo de membros
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Padrões de qualificação 'this.'
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Nomenclatura para Interfaces (Prefixadas com I)
dotnet_naming_rule.interface_should_be_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interface_should_be_prefixed_with_i.style = prefix_with_i_style
dotnet_naming_rule.interface_should_be_prefixed_with_i.severity = suggestion

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.prefix_with_i_style.required_prefix = I
dotnet_naming_style.prefix_with_i_style.capitalization = pascal_case
